{
  "ssh": {
    "host": "cowrie-host",
    "executable": "ssh",
    "timeout_seconds": 90
  },
  "state_file": "state/snapshots.json",
  "log_file": "logs/monitor.log",
  "webhook_env": "DISCORD_WEBHOOK_URL",
  "notify_initial": false,
  "checks": [
    {
      "name": "commands",
      "mention_everyone": false,
      "interval_seconds": 0,
      "file": "/opt/cowrie/var/log/cowrie/cowrie.json",
      "json_field": "input",
      "event_ids": [
        "cowrie.command.input"
      ]
    },
    {
      "name": "uploads",
      "mention_everyone": false,
      "interval_seconds": 0,
      "file": "/opt/cowrie/var/log/cowrie/cowrie.json",
      "json_field": "message",
      "event_ids": [
        "cowrie.session.file_download",
        "cowrie.session.file_upload"
      ]
    },
    {
      "name": "user",
      "mention_everyone": false,
      "interval_seconds": 0,
      "file": "/opt/cowrie/var/log/cowrie/cowrie.json",
      "json_field": "username",
      "event_ids": [
        "cowrie.login.failed",
        "cowrie.login.success"
      ]
    },
    {
      "name": "password",
      "mention_everyone": false,
      "interval_seconds": 0,
      "file": "/opt/cowrie/var/log/cowrie/cowrie.json",
      "json_field": "password",
      "event_ids": [
        "cowrie.login.failed",
        "cowrie.login.success"
      ]
    },
    {
      "name": "source-addresses",
      "mention_everyone": false,
      "interval_seconds": 0,
      "file": "/opt/cowrie/var/log/cowrie/cowrie.json",
      "json_field": "src_ip",
      "event_ids": [
        "cowrie.session.connect"
      ]
    }
  ]
}
